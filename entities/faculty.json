{
  "name": "Faculty",
  "type": "object",
  "properties": {
    "faculty_id": {
      "type": "string",
      "description": "Unique faculty ID"
    },
    "first_name": {
      "type": "string",
      "description": "Faculty's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Faculty's last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Faculty email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "department": {
      "type": "string",
      "description": "Faculty department"
    },
    "position": {
      "type": "string",
      "enum": [
        "Professor",
        "Associate Professor",
        "Assistant Professor",
        "Lecturer",
        "Instructor"
      ],
      "description": "Academic position"
    },
    "office_location": {
      "type": "string",
      "description": "Office location"
    },
    "office_hours": {
      "type": "string",
      "description": "Office hours"
    },
    "specialization": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Areas of specialization"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "description": "Date of hire"
    },
    "salary": {
      "type": "number",
      "description": "Annual salary"
    }
  },
  "required": [
    "faculty_id",
    "first_name",
    "last_name",
    "email",
    "department",
    "position"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}