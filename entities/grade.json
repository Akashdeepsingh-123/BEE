{
  "name": "Grade",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Student record ID"
    },
    "exam_id": {
      "type": "string",
      "description": "Exam record ID"
    },
    "course_id": {
      "type": "string",
      "description": "Course record ID"
    },
    "marks_obtained": {
      "type": "number",
      "description": "Marks obtained by student"
    },
    "total_marks": {
      "type": "number",
      "description": "Total marks for the exam"
    },
    "percentage": {
      "type": "number",
      "description": "Percentage score"
    },
    "letter_grade": {
      "type": "string",
      "enum": [
        "A+",
        "A",
        "A-",
        "B+",
        "B",
        "B-",
        "C+",
        "C",
        "C-",
        "D+",
        "D",
        "F"
      ],
      "description": "Letter grade"
    },
    "graded_date": {
      "type": "string",
      "format": "date",
      "description": "Date when graded"
    },
    "feedback": {
      "type": "string",
      "description": "Feedback from instructor"
    }
  },
  "required": [
    "student_id",
    "exam_id",
    "course_id",
    "marks_obtained",
    "total_marks"
  ],
  "rls": {
    "read": {},
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}